# =============================================================================
# AI Council - Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# API Keys (at least one required for backend to function)
# -----------------------------------------------------------------------------
# Get your Groq API key at: https://console.groq.com/keys
GROQ_API_KEY=

# Get your NVIDIA API key at: https://build.nvidia.com/
NVIDIA_API_KEY=

# Get your Gemini API key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Get your OpenRouter API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# Backend Configuration
# -----------------------------------------------------------------------------
# API key for authenticating requests to /v1/ask (required in production)
API_KEY=

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:8501

# Rate limiting: requests per window per IP
RATE_LIMIT_REQUESTS=10

# Rate limiting window in seconds
RATE_LIMIT_WINDOW=60

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Environment: development, staging, production
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Model Configuration (Expert: Operator)
# -----------------------------------------------------------------------------
EXPERT_OPERATOR_PROVIDER=groq
EXPERT_OPERATOR_MODEL=openai/gpt-oss-20b
EXPERT_OPERATOR_MAX_TOKENS=500
EXPERT_OPERATOR_TIMEOUT=35

# -----------------------------------------------------------------------------
# Model Configuration (Expert: Analyst)
# -----------------------------------------------------------------------------
EXPERT_ANALYST_PROVIDER=groq
EXPERT_ANALYST_MODEL=openai/gpt-oss-20b
EXPERT_ANALYST_MAX_TOKENS=500
EXPERT_ANALYST_TIMEOUT=35

# -----------------------------------------------------------------------------
# Model Configuration (Expert: Risk)
# -----------------------------------------------------------------------------
EXPERT_RISK_PROVIDER=groq
EXPERT_RISK_MODEL=openai/gpt-oss-20b
EXPERT_RISK_MAX_TOKENS=500
EXPERT_RISK_TIMEOUT=35

# -----------------------------------------------------------------------------
# Model Configuration (Expert: Researcher)
# -----------------------------------------------------------------------------
EXPERT_RESEARCHER_PROVIDER=groq
EXPERT_RESEARCHER_MODEL=openai/gpt-oss-120b
EXPERT_RESEARCHER_MAX_TOKENS=500
EXPERT_RESEARCHER_TIMEOUT=35

# -----------------------------------------------------------------------------
# Model Configuration (Decision Architect)
# -----------------------------------------------------------------------------
ARCHITECT_PROVIDER=groq
ARCHITECT_MODEL=openai/gpt-oss-20b
ARCHITECT_MAX_TOKENS=300
ARCHITECT_TIMEOUT=35

# -----------------------------------------------------------------------------
# Model Configuration (Chairman)
# -----------------------------------------------------------------------------
CHAIRMAN_PROVIDER=groq
CHAIRMAN_MODEL=openai/gpt-oss-120b
CHAIRMAN_MAX_TOKENS=700
CHAIRMAN_TIMEOUT=35

# -----------------------------------------------------------------------------
# Council Configuration
# -----------------------------------------------------------------------------
MIN_COUNCIL_SIZE=2
MAX_COUNCIL_SIZE=3
ANCHOR_EXPERTS=risk
DEFAULT_COUNCIL_KEYS=operator,analyst,risk,researcher

# -----------------------------------------------------------------------------
# Debate Configuration
# -----------------------------------------------------------------------------
SKIP_DEBATE_AGREEMENT_THRESHOLD=0.85
SKIP_DEBATE_CONFIDENCE_THRESHOLD=0.6
DEBATE_CONCURRENCY_LIMIT=2

# -----------------------------------------------------------------------------
# Cache Configuration
# -----------------------------------------------------------------------------
COUNCIL_CACHE_TTL=900
COUNCIL_CACHE_MAXSIZE=200

# -----------------------------------------------------------------------------
# Limits
# -----------------------------------------------------------------------------
MAX_PROMPT_CHARS=12000
MAX_CONTEXT_CHARS=28000

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
DEFAULT_BACKEND_URL=http://localhost:8000
ALLOWED_BACKEND_DOMAINS=localhost
FRONTEND_TIMEOUT_CONNECT=10
FRONTEND_TIMEOUT_READ=240
