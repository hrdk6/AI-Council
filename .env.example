# =============================================================================
# AI Council - Environment Configuration
# Copy this file to .env (repository root) and fill in your values.
# The backend also reads backend/.env; the frontend also reads frontend/.env.
# Blank values fall back to the defaults shown in the comments.
# =============================================================================

# -----------------------------------------------------------------------------
# Provider API keys - only the providers used by the roles below are required
# -----------------------------------------------------------------------------
# https://console.groq.com/keys (the default configuration uses only Groq)
GROQ_API_KEY=
# https://build.nvidia.com/
NVIDIA_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# Backend security
# -----------------------------------------------------------------------------
# The access key. The web interface asks for it once; API clients send it in the
# X-API-Key header. REQUIRED when ENVIRONMENT=production (and for docker compose).
# Leave empty for a private local setup. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# development | staging | production | test
ENVIRONMENT=development

# Comma-separated CORS origins for API clients on other domains ("*" is rejected in production).
# The built-in web interface is same-origin and doesn't need an entry.
ALLOWED_ORIGINS=http://localhost:8000

# Per-client-IP limit on /v1/ask and /v1/ask/stream
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# DEBUG | INFO | WARNING | ERROR (JSON logs in staging/production)
LOG_LEVEL=INFO

# SQLite decision history location (default: backend/data/ai_council.db)
DATABASE_PATH=

# Seconds between SSE keep-alive comments while the council deliberates
STREAM_HEARTBEAT_SECONDS=15

# -----------------------------------------------------------------------------
# Models - provider is one of: groq, nvidia_nim, gemini, openrouter
# -----------------------------------------------------------------------------
EXPERT_OPERATOR_PROVIDER=groq
EXPERT_OPERATOR_MODEL=openai/gpt-oss-20b
EXPERT_OPERATOR_MAX_TOKENS=500
EXPERT_OPERATOR_TIMEOUT=35

EXPERT_ANALYST_PROVIDER=groq
EXPERT_ANALYST_MODEL=openai/gpt-oss-20b
EXPERT_ANALYST_MAX_TOKENS=500
EXPERT_ANALYST_TIMEOUT=35

EXPERT_RISK_PROVIDER=groq
EXPERT_RISK_MODEL=openai/gpt-oss-20b
EXPERT_RISK_MAX_TOKENS=500
EXPERT_RISK_TIMEOUT=35

EXPERT_RESEARCHER_PROVIDER=groq
EXPERT_RESEARCHER_MODEL=openai/gpt-oss-120b
EXPERT_RESEARCHER_MAX_TOKENS=500
EXPERT_RESEARCHER_TIMEOUT=35

ARCHITECT_PROVIDER=groq
ARCHITECT_MODEL=openai/gpt-oss-20b
ARCHITECT_MAX_TOKENS=300
ARCHITECT_TIMEOUT=35

CHAIRMAN_PROVIDER=groq
CHAIRMAN_MODEL=openai/gpt-oss-120b
CHAIRMAN_MAX_TOKENS=1200
CHAIRMAN_TIMEOUT=35

# Backup models. When a model is rate-limited or fails, the member switches to the next one
# automatically. Each Groq model has its own rate limit, so more models means more headroom.
GROQ_FALLBACK_CHAIN=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b,qwen/qwen3.6-27b
# Optional backups on other providers, tried after the chain (skipped unless that provider's key is set).
# Format provider:model, comma-separated. Example:
#   BACKUP_MODELS=gemini:gemini-2.5-flash,openrouter:meta-llama/llama-3.3-70b-instruct:free
BACKUP_MODELS=
# Seconds a rate-limited model is skipped when the provider doesn't say how long to wait
RATE_LIMIT_COOLDOWN_S=30

# Reasoning effort for gpt-oss models: low | medium | high (empty = provider default).
# Keep "low" on small token budgets: at higher effort the model can spend every token
# thinking and return an empty answer.
REASONING_EFFORT=low

# -----------------------------------------------------------------------------
# Evidence uploads (PDFs and images)
# -----------------------------------------------------------------------------
# Vision-capable models, tried in order, for images and scanned PDF pages
VISION_PROVIDER=groq
VISION_MODELS=qwen/qwen3.8-27b,qwen/qwen3.6-27b
VISION_MAX_TOKENS=1500
VISION_TIMEOUT=60
# Set MAX_UPLOAD_FILES=0 to turn uploads off
MAX_UPLOAD_FILES=5
MAX_PDF_MB=15
MAX_IMAGE_MB=8
# Text is extracted from up to this many pages per PDF
MAX_PDF_PAGES=40
# Pages read visually when a PDF has no text layer (a scan)
MAX_OCR_PAGES=3

# -----------------------------------------------------------------------------
# Council behaviour
# -----------------------------------------------------------------------------
MIN_COUNCIL_SIZE=2
MAX_COUNCIL_SIZE=3
ANCHOR_EXPERTS=risk
DEFAULT_COUNCIL_KEYS=operator,analyst,risk,researcher

SKIP_DEBATE_AGREEMENT_THRESHOLD=0.85
SKIP_DEBATE_CONFIDENCE_THRESHOLD=0.6
DEBATE_CONCURRENCY_LIMIT=2

COUNCIL_CACHE_TTL=900
COUNCIL_CACHE_MAXSIZE=200

MAX_PROMPT_CHARS=12000
# Shared by uploaded evidence and source links; split evenly between files
MAX_CONTEXT_CHARS=28000

# -----------------------------------------------------------------------------
# Web interface
# -----------------------------------------------------------------------------
# Directory served at "/" (default: frontend/public). Leave empty unless you move it.
FRONTEND_DIR=
